{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Nirimaki fastfetch — user-owned (seeded copy-once, like foot/tmux).
  // Traditional left-logo layout: a maki cross-section glyph beside the
  // info. Logo zones (1 nori / 2 rice / 3 filling) and key colors use
  // NAMED palette entries (not hex) so they track whatever terminal
  // theme is active without a regeneration step.
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "color": { "1": "green", "2": "white", "3": "magenta" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    { "type": "title", "keyColor": "blue" },
    { "type": "custom", "format": "────────────────────────────" },
    { "type": "os",       "key": "OS      ", "keyColor": "blue" },
    { "type": "kernel",   "key": "Kernel  ", "keyColor": "blue" },
    { "type": "uptime",   "key": "Uptime  ", "keyColor": "blue" },
    { "type": "packages", "key": "Packages", "keyColor": "blue" },
    { "type": "wm",       "key": "WM      ", "keyColor": "blue" },
    { "type": "shell",    "key": "Shell   ", "keyColor": "blue" },
    { "type": "terminal", "key": "Terminal", "keyColor": "blue" },
    { "type": "custom", "format": "────────────────────────────" },
    { "type": "cpu",    "key": "CPU     ", "keyColor": "magenta" },
    { "type": "gpu",    "key": "GPU     ", "keyColor": "magenta" },
    { "type": "memory", "key": "Memory  ", "keyColor": "magenta" },
    { "type": "disk",   "key": "Disk    ", "keyColor": "magenta", "folders": "/" },
    "break",
    { "type": "colors", "paddingLeft": 1, "symbol": "circle" }
  ]
}
