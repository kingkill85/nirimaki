// niri config — your entry-point. Edit freely; install.sh seeds this
// file once and never touches it again.
//
// Loads Nirimaki defaults from ~/.local/share/nirimaki/default/niri/
// (upgrade-tracked by `git pull`), THEN your overrides below. niri's
// include is last-wins for keyed nodes (window-rule, output, environment,
// input), so anything you declare in the user files supersedes the
// corresponding default.
//
// Wiki: https://niri-wm.github.io/niri/Configuration:-Introduction

// ===== Nirimaki defaults — DO NOT edit these paths =====
// Run `nirimaki upgrade` (or `git pull` in the dev repo) to refresh.
include "~/.local/share/nirimaki/default/niri/input.kdl"
include "~/.local/share/nirimaki/default/niri/looknfeel.kdl"
include "~/.local/share/nirimaki/default/niri/autostart.kdl"
include "~/.local/share/nirimaki/default/niri/windows.kdl"
include "~/.local/share/nirimaki/default/niri/bindings.kdl"

// ===== Your overrides =====
// monitors.kdl is required (niri can't auto-detect on cold boot for
// every config); the others are optional but always exist as empty
// stubs so this include chain stays valid.
include "~/.config/niri/monitors.kdl"
include "~/.config/niri/input.kdl"
include "~/.config/niri/windows.kdl"
include "~/.config/niri/bindings.kdl"
include "~/.config/niri/autostart.kdl"
