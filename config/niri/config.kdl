// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

// Input device configuration.
// Find the full list of options on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Input
input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
            // For more information, see xkeyboard-config(7).

            // For example:
            // layout "us,ru"
            // options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"

            // If this section is empty, niri will fetch xkb settings
            // from org.freedesktop.locale1. You can control these using
            // localectl set-x11-keymap.
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="0%"
}

// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The built-in laptop monitor is usually called "eDP-1".
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Outputs
// Remember to uncomment the node by removing "/-"!
// Acer VG270U P (27" 1440p 144Hz) — primary, in front of user
output "DP-1" {
    mode "2560x1440@143.856"
    scale 1
    transform "normal"
    position x=0 y=1080
    variable-refresh-rate
}

// AOC 24G15N (24" 1080p 180Hz) — stacked above Acer, centered horizontally
output "DP-3" {
    mode "1920x1080@180.003"
    scale 1
    transform "normal"
    position x=320 y=0
    variable-refresh-rate
}

// Iiyama PL2783Q (27" 1440p) — right side, portrait (90° CCW), centered on Acer
output "DP-2" {
    mode "2560x1440@69.923"
    scale 1
    transform "90"
    position x=2560 y=600
    variable-refresh-rate

    // Portrait orientation: new columns open full-width by default
    // (50% of a 1440-wide portrait screen is too narrow to be useful).
    layout {
        default-column-width { proportion 1.0; }
    }
}

// Named, per-output workspaces (`workspace "<name>" { open-on-output "DP-X" }`)
// were tried during Phase C — see Step 37 in niri-setup.md — but reverted:
// they introduced extra always-present pills on each bar that didn't map
// to anything meaningful, and the labels obscured the simple idx layout.
// Bar pills are back to plain idx (`1 2 3` on each output).

// Layout (gaps, focus-ring/border colours, shadow, struts) lives in a
// generated include so `nirimaki-theme-set` can flip the focused-window
// border colour with the rest of the theme. Template source:
// ~/.config/theme/templates/niri-theme.kdl.tpl
include "~/.config/theme/current/niri-theme.kdl"

// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.

// Locale for niri-spawned children. niri's environment when launched by
// the display manager / TTY login on this system doesn't include LANG, so
// children inherit the C locale — that makes the Calendar / Weather
// widgets render English month names and weekday abbreviations even
// though /etc/locale.conf says de_DE.UTF-8. Setting it here propagates
// the locale to every spawn-at-startup child (quickshell included).
environment {
    LANG "de_DE.UTF-8"
    LC_TIME "de_DE.UTF-8"
    // Qt apps look up `QT_QPA_PLATFORMTHEME` to pick their platform
    // theme module; qt6ct then renders the palette in
    // ~/.config/theme/current/qt-colors.conf and uses the icon_theme
    // line in qt6ct.conf — both rewritten by nirimaki-theme-set.
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// Quickshell is the bar/shell.
spawn-at-startup "quickshell"

// Wallpaper — nirimaki-wallpaper-apply starts swaybg on the first image
// under ~/.config/theme/current/backgrounds/, with a solid-colour
// fallback if the theme ships no images. Same script runs from
// nirimaki-theme-set after every swap so the wallpaper follows the theme.
spawn-sh-at-startup "$HOME/.local/bin/nirimaki-wallpaper-apply"

// Feature-state snapshot — drives the SettingsMenu's
// install/remove filter (so already-installed apps don't appear
// under Install, and missing apps don't appear under Remove).
// Refreshed by nirimaki-hook-run after every install/remove event;
// this initial pass seeds the cache for the menu's first open.
spawn-sh-at-startup "$HOME/.local/bin/nirimaki-feature-state"

// Idle: lock after 5 min, power off displays after 10 min, lock before suspend.
// Niri auto-powers monitors back on at any input — no `resume` action needed.
spawn-sh-at-startup "swayidle -w timeout 300 'quickshell -p $HOME/.config/quickshell/lock/shell.qml' timeout 600 'niri msg action power-off-monitors' before-sleep 'quickshell -p $HOME/.config/quickshell/lock/shell.qml'"

// Clipboard history daemon for the Quickshell ClipboardPicker (Mod+Period).
// `wl-paste --watch` runs cliphist forever, recording every wl-clipboard
// selection. Needs `cliphist` + `wl-clipboard` packages.
spawn-sh-at-startup "wl-paste --watch cliphist store"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // Don't show the "Important Hotkeys" sheet on session start. The
    // overlay is still available on demand via Mod+Shift+/.
    skip-at-startup
}

// Ask clients to drop their client-side decorations. Apps that
// specifically need CSD (Nautilus header bar etc.) get it via the
// `prefer-no-csd false` window-rule below. This also makes niri's
// 2 px border draw cleanly around the actual content rectangle
// instead of behind translucent CSD shadows.
prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
// Used by niri's built-in `screenshot-window` / `screenshot-screen` actions
// (the Mod+Shift+S keybind uses its own grim+satty pipeline). niri only does
// `~` expansion + strftime here — no env vars / shell — so the German
// locale dir is hardcoded. If you change XDG_PICTURES_DIR, update this too.
screenshot-path "~/Bilder/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Animation settings.
// The wiki explains how to configure individual animations:
// https://niri-wm.github.io/niri/Configuration:-Animations
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0
}

// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Global blur tuning — moderate dual-kawase pass count, matches
// Hyprland's `decoration.blur { size=2; passes=2; }`. niri's defaults
// (passes 3, offset 3) lean blurrier than Omarchy. `saturation 1.0`
// neutralises niri's punchy default of 1.5; Omarchy compensates with
// `brightness=0.60 contrast=0.75`, which niri has no equivalent for,
// so this is the closest match to Omarchy's softer blur look.
blur {
    passes 2
    offset 2
    saturation 1.0
}

// Window blur + global defaults. Three things in one rule:
//   - blur+xray-false: real apps blur behind (Omarchy / Hyprland
//     parity; xray-mode would only blur the wallpaper). Caveat per
//     niri wiki: non-xray blur briefly disappears during
//     open/close animations and tile drags.
//   - opacity 0.97: active default — matches Omarchy's
//     `o.window(".*", { opacity = "0.97 0.9" })`.
//   - draw-border-with-background false (niri#1823 fix): default
//     niri renders focus-ring / border as a solid background
//     rectangle BEHIND the window; on translucent windows the
//     accent colour bleeds through and tints the interior. Forcing
//     border drawing AROUND every window keeps interiors pure.
window-rule {
    opacity 0.97
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}

// Inactive default opacity — 90 %, Omarchy parity. Per-app rules
// further down override this (the nirimaki-quake-term rule pins a fixed
// size, not opacity — terminals inherit the 0.97/0.9 default).
window-rule {
    match is-active=false
    opacity 0.9
}

// No per-terminal opacity override. Omarchy's
// `apps/terminals.conf` tags alacritty/kitty/ghostty/foot but applies
// the same `opacity 0.97 0.9` as the default rule — terminals are not
// extra-translucent. Foot therefore inherits the 0.97/0.9 active/
// inactive split from the global rules above (niri#1823 border-bleed
// fix lives on the global rule).

// No floating-specific opacity override. Omarchy has no floating-only
// rule; floats inherit `0.97 0.9` like everything else. (Earlier
// Nirimaki had 1.0 then 0.92 here — both diverged from Omarchy.)

// Browser opacity — Omarchy `apps/browser.conf` overrides the
// default-opacity tag with `opacity 1.0 0.97`: fully opaque when
// focused, 97 % when not. Translucency on web content is more
// distracting than on terminals so they get a tighter range.
// Matches Chromium-family (chrome/chromium/brave/edge/Vivaldi/helium)
// and Firefox-family (firefox/zen/librewolf, host + flatpak).
window-rule {
    match app-id=r#"^((google-)?[cC]hrom(e|ium)|[bB]rave-browser|[mM]icrosoft-edge|Vivaldi-stable|helium)$"#
    match app-id=r#"^(firefox|zen|librewolf)$"#
    match app-id=r#"^(org\.mozilla\.firefox|app\.zen_browser\.zen|io\.gitlab\.librewolf-community)$"#
    opacity 1.0
}
window-rule {
    match app-id=r#"^((google-)?[cC]hrom(e|ium)|[bB]rave-browser|[mM]icrosoft-edge|Vivaldi-stable|helium)$"# is-active=false
    match app-id=r#"^(firefox|zen|librewolf)$"# is-active=false
    match app-id=r#"^(org\.mozilla\.firefox|app\.zen_browser\.zen|io\.gitlab\.librewolf-community)$"# is-active=false
    opacity 0.97
}

// Always-opaque apps — Omarchy `apps/system.conf` forces
// `opacity 1 1` for media / video / image / screen-sharing tools.
// Translucency would let the desktop bleed through onto the actual
// content being shown, which is bad UX for these specifically.
//   - zoom: meeting client
//   - vlc / mpv: video playback
//   - org.kde.kdenlive: video editing
//   - com.obsproject.Studio: streaming / capture
//   - com.github.PintaProject.Pinta: image editor
//   - imv: image viewer
//   - org.gnome.NautilusPreviewer: Nautilus quick-look
window-rule {
    match app-id=r#"^(zoom|vlc|mpv|org\.kde\.kdenlive|com\.obsproject\.Studio|com\.github\.PintaProject\.Pinta|imv|org\.gnome\.NautilusPreviewer)$"#
    opacity 1.0
}

// Chromium webapps (nirimaki-webapp-* app-id) — fully opaque. Webapp
// content is browser content; translucency would degrade text
// rendering and the BrowserThemeColor accent stripe. The chrome
// itself recolours live on theme swap via the managed-policy
// path in nirimaki-theme-set.
window-rule {
    match app-id=r#"^nirimaki-webapp-"#
    opacity 1.0
}

// Layer-rule blur scoped to Quickshell dialog surfaces only.
//   - `quickshell` matches the Bar's default namespace.
//   - `nirimaki-*` matches each dialog's own layer surface (Launcher,
//     PowerMenu, SettingsMenu, KeybindSheet, all the pickers).
//   - The dim scrim that every dialog draws across the screen sits on
//     a SEPARATE layer surface with namespace `dialog-scrim` so
//     it does NOT match here — blur is only behind the dialog card,
//     not behind the scrim. This matches Omarchy's walker look:
//     blurred backdrop sits behind the dialog only, the rest of the
//     screen stays sharp.
// Slurp's `selection` namespace and swaybg's `wallpaper` namespace
// don't match and stay un-blurred — preserving screenshot region
// selection and the bare wallpaper. `xray false` so the user sees
// the actual workspace blurred behind the overlay, not just a
// blurred wallpaper that hides their apps.
layer-rule {
    match namespace=r#"^(quickshell|nirimaki-.*)$"#
    background-effect {
        blur true
        xray false
    }
}

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Zen Browser: force niri's tile size on first frame. Without this, Zen
// commits its first frame at a remembered (often huge) size and only snaps
// on the next event. tiled-state tells Zen to drop its CSD shadow/rounding
// (so its visible content matches the column edges), clip-to-geometry
// clamps any residual overflow.
window-rule {
    match app-id=r#"^zen$"#
    tiled-state true
    clip-to-geometry true
}

// Picture-in-picture players — matches Omarchy `apps/pip.conf`.
// Omarchy tags windows whose TITLE matches "Picture in Picture"
// (any browser) and applies: float on, pin on, size 600×338,
// opacity 1 1, border_size 0. niri has no "pin" (no equivalent to
// hyprland's pin-across-workspaces), and we keep niri's normal
// border to match window-focus styling. Size + opacity + float
// translate cleanly.
window-rule {
    match title="(?i)picture.?in.?picture"
    open-floating true
    opacity 1.0
    default-floating-position x=40 y=40 relative-to="top-right"
    default-column-width { fixed 600; }
    default-window-height { fixed 338; }
}

// Floating TUI/utility windows: foot TUIs (app-id "tui-<name>") and
// satty (the screenshot annotator). Fixed 1000×640 logical pixels.
// Opacity inherits from the global 0.97 / is-active=false 0.9 rules.
window-rule {
    match app-id=r#"^tui-"#
    match app-id="com.gabm.satty"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 640; }
}

// Quake-style drop-down terminal (Phase H6). nirimaki-quake-toggle spawns a
// single foot with --app-id=nirimaki-quake-term; this rule pins it floating
// at a wider 1400×720, larger than the TUI rule above for a roomier
// drop-down feel.
window-rule {
    match app-id="nirimaki-quake-term"
    open-floating true
    default-column-width { fixed 1400; }
    default-window-height { fixed 720; }
}

// Block password managers from screen capture — matches Omarchy
// `apps/1password.conf` + `apps/bitwarden.conf` which set
// `no_screen_share on` for these classes. niri's
// `block-out-from "screen-capture"` replaces every covered pixel
// with the focus-ring colour in screencast/screenshot output, so
// the vault contents never leak into a recording or screenshot.
//   - 1Password: matches the GUI app; Omarchy regex is `[p|P]assword`
//     (the pipe is literal inside the char class — sloppy in hypr,
//     here we use the cleaner `[pP]`).
//   - Bitwarden: GUI app + the Bitwarden Chrome extension popup
//     (Chrome creates a window per extension with the extension's
//     hash as the app-id suffix).
//   - KeePassXC + GNOME Secrets are included as well; they were the
//     original commented-out example and are the only other vaults
//     this user is likely to run.
window-rule {
    match app-id=r#"^1[pP]assword$"#
    match app-id=r#"^Bitwarden$"#
    match app-id=r#"^chrome-nngceckbapebfimnlniiiahkandclblb-Default$"#
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}

// Bitwarden — float by default (Electron window is dialog-shaped,
// doesn't tile gracefully). Matches Omarchy's apps/bitwarden.lua
// `tag = "+floating-window"`. Screen-capture block is on the rule
// above (Bitwarden is already in that match list).
window-rule {
    match app-id=r#"^Bitwarden$"#
    match app-id=r#"^chrome-nngceckbapebfimnlniiiahkandclblb-Default$"#
    open-floating true
}

// Steam — Valve client. Matches Omarchy's apps/steam.lua:
//   - opacity always 1.0 (game art / library thumbnails need full
//     fidelity; translucency on those bleeds the desktop through)
//   - floats by default (Steam's main UI is a single window that
//     wants a fixed size, plus dozens of transient popups —
//     friends list, achievements, dialogs — none of which tile well)
//   - main window pinned to 1100×700, Friends List to 460×800
//     (Omarchy parity)
window-rule {
    match app-id=r#"^steam$"#
    opacity 1.0
    open-floating true
}
window-rule {
    match app-id="steam" title="^Steam$"
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}
window-rule {
    match app-id="steam" title="^Friends List$"
    default-column-width { fixed 460; }
    default-window-height { fixed 800; }
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// All keybinds live in keybinds.kdl so binds are one grep / one
// edit away. Generated structure documented at the top of that file.
include "~/.config/niri/keybinds.kdl"
