# ~/.config/fish/config.fish — your fish entry-point.
#
# Seeded once by dev-link.sh / install.sh and never overwritten.
# Loaded AFTER everything in ~/.config/fish/conf.d/ (including
# Nirimaki's 00-nirimaki-init.fish), so any setting you put here
# wins over the defaults.
#
# Examples:
#
#   set -gx EDITOR nvim
#   abbr -a g git
#   alias ll 'eza -la --group-directories-first'
