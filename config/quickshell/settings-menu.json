{
  "_comment": [
    "Nirimaki SettingsMenu tree — loaded by SettingsMenu.qml at startup.",
    "User additions live in ~/.config/nirimaki/extensions/menu.json and",
    "are merged on top of this default tree (same-id entries override;",
    "new ids extend). See config/nirimaki/extensions/menu.json.sample.",
    "",
    "Schema per node:",
    "  icon       : nf glyph string (used in row prefix)",
    "  labelKey   : i18n key (looked up in i18n/<locale>.json)",
    "  label      : inline literal (use *instead* of labelKey)",
    "  children   : list of child ids — makes this node a branch",
    "  action     : { type, ...type-specific-fields } — makes this node a leaf",
    "",
    "Action types:",
    "  ipc              { target, fn? }              Quickshell IPC call",
    "  tui              { name, exec[] }             Floating foot via NiriService.launchTui",
    "  shell            { cmd }                      sh -lc 'cmd'",
    "  exec             { cmd[] }                    Quickshell.execDetached(cmd)",
    "  exec-in-foot     { appId, cmd[] }             foot --app-id=appId cmd...",
    "  quickshell-spawn { path }                     quickshell -p path",
    "",
    "$HOME is expanded at load time anywhere it appears in a string."
  ],

  "":         { "children": ["style", "setup", "install", "remove", "system"] },

  "style":    { "icon": "󰸌", "labelKey": "settings.style",
                "children": ["style.theme", "style.background", "style.keybinds"] },
  "style.theme":      { "icon": "󰸌", "labelKey": "settings.style.theme",
                        "action": { "type": "ipc", "target": "theme-picker" } },
  "style.background": { "icon": "󰸀", "labelKey": "settings.style.background",
                        "action": { "type": "ipc", "target": "background-picker" } },
  "style.keybinds":   { "icon": "󰌌", "labelKey": "settings.style.keybinds",
                        "action": { "type": "ipc", "target": "keybind-sheet" } },

  "setup":    { "icon": "󰒓", "labelKey": "settings.setup",
                "children": ["setup.audio", "setup.bluetooth", "setup.wifi",
                             "setup.browser", "setup.language"] },
  "setup.audio":     { "icon": "󰓃", "labelKey": "settings.setup.audio",
                       "action": { "type": "tui", "name": "wiremix", "exec": ["wiremix"] } },
  "setup.bluetooth": { "icon": "󰂯", "labelKey": "settings.setup.bluetooth",
                       "action": { "type": "shell", "cmd": "rfkill unblock bluetooth; foot --app-id=tui-bluetui bluetui" } },
  "setup.wifi":      { "icon": "󰖩", "labelKey": "settings.setup.wifi",
                       "action": { "type": "shell", "cmd": "rfkill unblock wifi 2>/dev/null; foot --app-id=tui-impala impala" } },
  "setup.browser":   { "icon": "󰖟", "labelKey": "settings.setup.browser",
                       "children": ["setup.browser.zen", "setup.browser.firefox", "setup.browser.chromium"] },
  "setup.browser.zen":      { "icon": "󰖟", "labelKey": "settings.setup.browser.zen",
                              "action": { "type": "exec", "cmd": ["$HOME/.local/bin/nirimaki-browser-default", "zen"] } },
  "setup.browser.firefox":  { "icon": "󰈹", "labelKey": "settings.setup.browser.firefox",
                              "action": { "type": "exec", "cmd": ["$HOME/.local/bin/nirimaki-browser-default", "firefox"] } },
  "setup.browser.chromium": { "icon": "󰊯", "labelKey": "settings.setup.browser.chromium",
                              "action": { "type": "exec", "cmd": ["$HOME/.local/bin/nirimaki-browser-default", "chromium"] } },
  "setup.language":  { "icon": "󰗊", "labelKey": "settings.setup.language",
                       "action": { "type": "ipc", "target": "language-picker" } },

  "install":  { "icon": "󰏗", "labelKey": "settings.install",
                "children": ["install.webapp", "install.ai"] },
  "install.webapp": { "icon": "󰖟", "labelKey": "settings.install.webapp",
                      "action": { "type": "exec-in-foot",
                                  "appId": "tui-nirimaki-webapp-install",
                                  "cmd":   ["$HOME/.local/bin/nirimaki-webapp-install"] } },
  "install.ai":     { "icon": "󱚤", "labelKey": "settings.install.ai",
                      "children": ["install.ai.voxtype"] },
  "install.ai.voxtype": { "icon": "󰍬", "labelKey": "settings.install.ai.voxtype",
                          "action": { "type": "exec-in-foot",
                                      "appId": "tui-nirimaki-voxtype-install",
                                      "cmd":   ["$HOME/.local/bin/nirimaki-voxtype-install"] } },

  "remove":   { "icon": "󰗨", "labelKey": "settings.remove",
                "children": ["remove.webapp", "remove.ai"] },
  "remove.webapp":  { "icon": "󰖟", "labelKey": "settings.remove.webapp",
                      "action": { "type": "exec-in-foot",
                                  "appId": "tui-nirimaki-webapp-remove",
                                  "cmd":   ["$HOME/.local/bin/nirimaki-webapp-remove"] } },
  "remove.ai":      { "icon": "󱚤", "labelKey": "settings.remove.ai",
                      "children": ["remove.ai.voxtype"] },
  "remove.ai.voxtype":  { "icon": "󰍬", "labelKey": "settings.remove.ai.voxtype",
                          "action": { "type": "exec-in-foot",
                                      "appId": "tui-nirimaki-voxtype-remove",
                                      "cmd":   ["$HOME/.local/bin/nirimaki-voxtype-remove"] } },

  "system":   { "icon": "󰐥", "labelKey": "settings.system",
                "children": ["system.lock", "system.suspend", "system.logout", "system.restart", "system.shutdown"] },
  "system.lock":     { "icon": "󰌾", "labelKey": "power.action.lock",
                       "action": { "type": "quickshell-spawn", "path": "$HOME/.config/quickshell/lock/shell.qml" } },
  "system.suspend":  { "icon": "󰒲", "labelKey": "power.action.suspend",
                       "action": { "type": "exec", "cmd": ["systemctl", "suspend"] } },
  "system.logout":   { "icon": "󰍃", "labelKey": "power.action.logout",
                       "action": { "type": "exec", "cmd": ["niri", "msg", "action", "quit", "--skip-confirmation"] } },
  "system.restart":  { "icon": "󰜉", "labelKey": "power.action.restart",
                       "action": { "type": "exec", "cmd": ["systemctl", "reboot"] } },
  "system.shutdown": { "icon": "󰐥", "labelKey": "power.action.shutdown",
                       "action": { "type": "exec", "cmd": ["systemctl", "poweroff"] } }
}
