#!/bin/bash
# Sample hook — pops a desktop notification when `nirimaki-update`
# finishes. Activate by removing the `.sample` suffix and making it
# executable:
#   chmod +x ~/.config/nirimaki/hooks/post-update.d/show-update-notification
#
# The hook is called with no arguments.

notify-send -u low -t 4000 "Nirimaki" "Update complete."
