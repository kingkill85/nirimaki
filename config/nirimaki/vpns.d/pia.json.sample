{
  "_comment": [
    "Private Internet Access — driven entirely via the piactl CLI,",
    "no GUI / tray icon. The Network panel's Add form collects your",
    "account credentials, hands them to `piactl login`, then runs",
    "`piactl background enable` so the daemon stays up without",
    "pia-client running.",
    "",
    "Set a region below to override on every connect, or leave it",
    "as `auto` to let the daemon pick. piactl runs against PIA's",
    "user-session daemon (piavpn.service) — no sudo / polkit."
  ],
  "id":   "pia",
  "name": "Private Internet Access",
  "icon": "󰒃",

  "install": {
    "package": "piavpn-bin",
    "binary":  "piactl",
    "hint":    "AUR package `piavpn-bin`. Sign in via Network → VPN → Add connection."
  },

  "fields": [
    { "key":     "region",
      "label":   "Preferred region",
      "help":    "PIA server region. `auto` picks the lowest-latency one.",
      "type":    "dropdown",
      "optionsCmd": ["piactl", "get", "regions"],
      "value":   "auto" }
  ],

  "statusCmd":        ["piactl", "get", "connectionstate"],
  "statusOnPattern":  "^Connected$",
  "statusLabelCmd":   ["piactl", "get", "region"],
  "connectCmd":       ["sh", "-lc",
    "if [ '{{region}}' != 'auto' ]; then piactl set region {{region}}; fi; piactl connect"],
  "disconnectCmd":    ["piactl", "disconnect"],
  "removeCmd":        ["piactl", "logout"],
  "pollSeconds":      5
}
