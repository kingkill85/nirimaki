{
  "_comment": [
    "SonicWall NetExtender SSL VPN provider.",
    "",
    "Connection details (server, domain, username) live in fields[]",
    "below. Password lives in the user keyring under schema",
    "  nirimaki-vpn  <connection-id>",
    "(populated by the panel's Add flow via secret-tool). connectCmd",
    "looks the password up inline.",
    "",
    "Status detection is process-based — `pgrep netExtender` returns",
    "0 only while the tunnel is up. statusLabelCmd extracts the",
    "tunnel IP from `ip -4 addr show ppp0` (NetExtender uses ppp0).",
    "",
    "Connect output goes to ~/.cache/nirimaki/netextender-<id>.log so",
    "you can debug bad credentials / wrong server with:",
    "    tail -f ~/.cache/nirimaki/netextender-<id>.log",
    "",
    "No sudo / polkit involved — netExtender runs in the user's",
    "session."
  ],
  "id":   "netextender",
  "name": "SonicWall NetExtender",
  "icon": "󰦝",
  "multiInstance": true,

  "install": {
    "package": "netextender",
    "binary":  "netExtender",
    "hint":    "AUR package `netextender`. Add a connection from Network → VPN — the panel collects server/domain/username + stores the password in your keyring."
  },

  "fields": [
    { "key":   "server",
      "label": "Server",
      "help":  "Hostname or IP of the SonicWall gateway (e.g. vpn.example.com).",
      "type":  "text",
      "value": "" },
    { "key":   "domain",
      "label": "Domain",
      "help":  "SonicWall domain. nxcli accepts lowercase.tld (e.g. nupis.de) or a single CamelCase word (e.g. LocalDomain).",
      "type":  "text",
      "value": "" },
    { "key":   "username",
      "label": "Username",
      "help":  "Your SonicWall username.",
      "type":  "text",
      "value": "" },
    { "key":   "password",
      "label": "Password",
      "help":  "Stored in your keyring under schema nirimaki-vpn. Leave blank to keep the existing one.",
      "type":  "secret",
      "value": "" }
  ],

  "statusCmd":        ["sh", "-lc", "ip -4 addr show snwl_ssltunnel 2>/dev/null | grep -c 'inet '"],
  "statusOnPattern":  "^[1-9]",
  "statusLabelCmd":   ["sh", "-lc", "ip -o -4 addr show snwl_ssltunnel 2>/dev/null | awk '{print $4}' | cut -d/ -f1"],
  "connectCmd":       ["sh", "-lc",
    "mkdir -p \"$HOME/.cache/nirimaki\" && { L=\"$HOME/.cache/nirimaki/netextender-{{id}}.log\"; printf '=== Connect \"%s\" @ %s ===\\nServer:   %s\\nDomain:   %s\\nUsername: %s\\n\\n' '{{name}}' \"$(date +'%Y-%m-%d %H:%M:%S')\" '{{server}}' '{{domain}}' '{{username}}' > \"$L\"; PW=$(secret-tool lookup nirimaki-vpn '{{id}}'); script -qc \"nxcli connection del '{{id}}'\" /dev/null 2>/dev/null; script -qc \"nxcli connection add '{{id}}' -s '{{server}}' -d '{{domain}}' -u '{{username}}' -p \\\"$PW\\\" -v SSLVPN\" /dev/null 2>&1 | grep -avE 'Skript |COMMAND_EXIT|nxcli connection add.*-p' | sed 's/^/[add] /' >> \"$L\"; script -qc \"nxcli connect '{{id}}' -p \\\"$PW\\\"\" /dev/null 2>&1 | grep -avE 'Skript |COMMAND_EXIT|nxcli connect.*-p' | sed 's/^/[connect] /' >> \"$L\"; } &"],
  "disconnectCmd":    ["sh", "-lc", "script -qc 'nxcli disconnect' /dev/null"],
  "removeCmd":        ["sh", "-lc", "script -qc 'nxcli connection del {{id}}' /dev/null 2>&1 || true; secret-tool clear nirimaki-vpn '{{id}}' 2>/dev/null || true"],
  "pollSeconds":      5
}
