# Nirimaki base package list — Arch official repos (extra/core/multilib).
# Each non-blank, non-comment line is one pacman package. install.sh
# (install/packaging.sh _pkg_base) feeds this to pacman -S --needed
# --noconfirm.
#
# Standard tools the user always gets, no menu entry:
#   - mise:     version manager for the Install → Development menu
#   - opencode: AI coding assistant (Arch extra)
#   - nodejs / npm: pre-installed so pi's bootstrap-extras installer
#                   doesn't fall into its interactive "Install Node.js
#                   with standalone Node.js? [Y/n]" prompt (pi has no
#                   pacman/Arch path, only apt/apk/homebrew/standalone).
#
# Compositor / shell / theme packages are listed inline in
# install/packaging.sh §2b–§2c, not here — keeping this file short
# matches its original purpose: the always-on standard tools.

mise
opencode
nodejs
npm
