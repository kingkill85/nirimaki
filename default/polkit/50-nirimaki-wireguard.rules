// Nirimaki — passwordless wg-quick@.service control for wheel-group
// users on local active sessions. Installed by the wireguard provider
// template (config/nirimaki/vpns.d/wireguard.json.sample) so the
// network panel's connect/disconnect buttons don't trigger a polkit
// password dialog every time.
//
// Scope is intentionally narrow: only wg-quick@*.service units, only
// systemd manage-unit{,-files} actions. Everything else still goes
// through the normal polkit decision path.

polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.systemd1.manage-units" &&
        action.id != "org.freedesktop.systemd1.manage-unit-files") {
        return;
    }
    var unit = action.lookup("unit");
    if (!unit || unit.indexOf("wg-quick@") != 0) {
        return;
    }
    if (subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
