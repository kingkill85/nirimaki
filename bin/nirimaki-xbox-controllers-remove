#!/bin/bash
# nirimaki:group=xbox-controllers
# nirimaki:summary=Remove xpadneo and undo its blacklist / autoload config
# nirimaki:requires-sudo=true
#
# Inverse of nirimaki-xbox-controllers-install. The `input`-group
# membership added by the install isn't undone — it's harmless and
# may already have been there for other reasons (e.g. uinput tooling).

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
nirimaki_banner "Xbox controllers" "Remove"

if ! pacman -Qi xpadneo-dkms >/dev/null 2>&1; then
  echo "xpadneo-dkms is not installed — nothing to do."
  nirimaki_pause
  exit 0
fi

echo "Removing xpadneo and undoing the module/blacklist config."
echo "Your user stays in the input group (harmless, may be in use by"
echo "uinput / virtual-keyboard tooling)."

nirimaki_sudo_prime

sudo pacman -Rns --noconfirm xpadneo-dkms 2>/dev/null || true
sudo rm -f /etc/modprobe.d/blacklist-xpad.conf
sudo rm -f /etc/modules-load.d/xpadneo.conf

cat <<'NOTE'

  ✓ xpadneo removed and module config cleared.
  → Reboot to fully unload xpadneo and restore the in-kernel xpad
    driver. Controllers keep working over either driver in the
    meantime.
NOTE

[[ -x $HOME/.local/bin/nirimaki-feature-state ]] && \
  "$HOME/.local/bin/nirimaki-feature-state" || true

[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" xbox-controllers-removed || true

nirimaki_pause
