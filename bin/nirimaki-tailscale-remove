#!/bin/bash
# nirimaki:group=tailscale
# nirimaki:summary=Remove Tailscale (drops daemon, package, admin webapp)
# nirimaki:requires-sudo=true

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
nirimaki_banner "Tailscale" "Remove"

if ! command -v tailscale >/dev/null 2>&1; then
  echo "tailscale is not installed — nothing to do."
  nirimaki_pause
  exit 0
fi

echo "Removing:"
echo "  - tailscaled.service (disable + stop)"
echo "  - tailscale package"
echo "  - admin-console webapp (if present)"

nirimaki_sudo_prime

echo
echo "Disconnecting + stopping daemon…"
sudo tailscale down 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true

echo "Uninstalling tailscale…"
sudo pacman -Rns --noconfirm tailscale 2>/dev/null || true

# Drop the admin webapp if we registered one.
desktop="$HOME/.local/share/applications/nirimaki-webapp-tailscale.desktop"
icon="$HOME/.local/share/applications/icons/nirimaki-webapp-tailscale.png"
data="$HOME/.cache/nirimaki-webapps/tailscale"
if [[ -f $desktop ]]; then
  echo "Dropping Tailscale webapp…"
  rm -f -- "$desktop" "$icon"
  rm -rf -- "$data"
  command -v update-desktop-database >/dev/null 2>&1 \
    && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
fi

# Drop the VPN bar-widget entry. The .sample stays (it's a symlink
# back to the repo) so a future `nirimaki tailscale install` can
# re-activate without manual file shuffling.
ts_cfg="$HOME/.config/nirimaki/vpns.d/tailscale.json"
if [[ -f $ts_cfg ]]; then
  echo "Dropping Tailscale VPN bar-widget entry…"
  rm -f -- "$ts_cfg"
fi

# If no VPN providers remain (no custom JSON files AND no NM VPN
# profiles), drop the vpn pill from shell.json's bar layout — Row
# spacing leaves a phantom gap around an empty Loader slot, so the
# whole entry has to go to avoid that.
shelljson="$HOME/.config/nirimaki/shell.json"
if [[ -f $shelljson ]] && command -v jq >/dev/null 2>&1; then
  custom=0
  if [[ -d $HOME/.config/nirimaki/vpns.d ]]; then
    custom=$(find "$HOME/.config/nirimaki/vpns.d" -maxdepth 1 -name '*.json' ! -name '*.json.sample' 2>/dev/null | wc -l)
  fi
  nm_count=0
  if command -v nmcli >/dev/null 2>&1; then
    nm_count=$(nmcli -t -f TYPE connection show 2>/dev/null | grep -cE '^(vpn|wireguard)$' || true)
  fi
  total=$((custom + nm_count))
  if (( total == 0 )); then
    tmp=$(mktemp "${shelljson}.XXXXXX")
    jq '.bar.layout.right |= map(select(.id != "vpn"))' "$shelljson" > "$tmp" && mv -- "$tmp" "$shelljson"
    echo "Removed vpn pill from shell.json (no providers remain)."
  fi
fi

echo
echo "  ✓ Tailscale removed."

[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" tailscale-removed || true

nirimaki_pause
