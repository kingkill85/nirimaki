#!/bin/bash
# nirimaki:group=brightness
# nirimaki:summary=Step every external monitor's brightness via DDC/CI
# nirimaki:args=raise|lower
# nirimaki-brightness-display — adjust brightness on every DDC/CI-capable monitor
# via ddcutil, then pop the OSD bezel. Used by niri XF86MonBrightness*
# keybinds.
#
# Omarchy's omarchy-brightness-display uses brightnessctl against
# /sys/class/backlight, which is the laptop-backlight path; on this
# desktop with 3 external DP monitors that directory is empty, so we
# drive the panels' built-in brightness controls over the I²C DDC/CI
# bus instead.
#
# Usage:
#   qs-brightness-display raise    # +5 (clamped to 100)
#   qs-brightness-display lower    # -5 (clamped to 0)
#   qs-brightness-display +N | -N
#   qs-brightness-display <N>      # absolute, 0-100
#
# DDC/CI is slow (~0.5-2 s per monitor) so the OSD shows the FIRST
# monitor's reading and the other panels catch up afterwards.

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

action="${1:-}"
[[ -z $action ]] && { echo "usage: $0 <raise|lower|±N|N>" >&2; exit 1; }

case "$action" in
    raise) delta=+5 ;;
    lower) delta=-5 ;;
    +*|-*) delta="$action" ;;
    [0-9]*) target="$action" ;;
    *) echo "unknown action: $action" >&2; exit 1 ;;
esac

# Discover I²C bus numbers for DDC-capable displays (one per line).
mapfile -t buses < <(ddcutil detect --terse 2>/dev/null \
                      | awk '/^I2C bus:/ { sub(".*-", "", $NF); print $NF }')

if [[ ${#buses[@]} -eq 0 ]]; then
    nirimaki-osd -i brightness -m "No DDC/CI display"
    exit 1
fi

apply_to_bus() {
    local bus=$1 want=$2
    # VCP code 10 = brightness, 0-100 percent.
    ddcutil --bus="$bus" --brief setvcp 10 "$want" 2>/dev/null || true
}

read_from_bus() {
    local bus=$1
    # `getvcp 10 --brief` → "VCP 10 C <current> <max>" (space-separated).
    ddcutil --bus="$bus" --brief getvcp 10 2>/dev/null \
        | awk '/^VCP 10/ { print $4 }'
}

primary=${buses[0]}
current=$(read_from_bus "$primary")
[[ -z $current ]] && current=0

if [[ -n ${target:-} ]]; then
    new=$target
else
    new=$(( current + delta ))
fi
(( new < 0 )) && new=0
(( new > 100 )) && new=100

for bus in "${buses[@]}"; do
    apply_to_bus "$bus" "$new" &
done
wait

nirimaki-osd -i brightness -p "$new"
