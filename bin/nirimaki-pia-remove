#!/bin/bash
# nirimaki:group=pia
# nirimaki:summary=Remove Private Internet Access (package + Nirimaki integration)
# nirimaki:requires-sudo=true

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
. "$HOME/.local/bin/nirimaki-vpn-provider-helpers"

nirimaki_banner "Private Internet Access" "Remove"

if ! command -v piactl >/dev/null 2>&1; then
  echo "pia is not installed — nothing to remove."
  nirimaki_pause
  exit 0
fi

echo "Removing:"
echo "  - Nirimaki bar-widget entry (~/.config/nirimaki/vpns.d/pia.json)"
echo "  - piavpn-bin package (piactl + pia-client + daemon)"

nirimaki_sudo_prime

echo
echo "Disconnecting (best-effort)…"
piactl disconnect 2>/dev/null || true

echo "Stopping + disabling piavpn.service…"
sudo systemctl disable --now piavpn.service 2>/dev/null || true

echo "Uninstalling piavpn-bin…"
sudo pacman -Rns --noconfirm piavpn-bin 2>/dev/null || true

echo
vpn_unregister pia

echo
echo "  ✓ Private Internet Access removed."

[[ -x $HOME/.local/bin/nirimaki-feature-state ]] && \
  "$HOME/.local/bin/nirimaki-feature-state" >/dev/null 2>&1 || true
[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" pia-removed || true

nirimaki_pause
