#!/bin/bash
# nirimaki:group=osd
# nirimaki:summary=Pop the on-screen overlay bezel via Quickshell IPC
# nirimaki:args=<icon> <message> [progress]
# nirimaki-osd — show the Quickshell OSD bezel.
# Port of Omarchy's `omarchy-osd`. Forwards an icon / message / progress
# triple to the `osd` IPC channel served by ~/.config/quickshell/Osd.qml.
#
# Usage:
#   qs-osd -i volume-high -p 42
#   qs-osd -i microphone-muted -m "Microphone muted"

set -euo pipefail

icon=""
message=""
progress=""
max="100"

while (($#)); do
  case $1 in
    -i|--icon)     icon="${2:-}";     shift 2 ;;
    -m|--message)  message="${2:-}";  shift 2 ;;
    -p|--progress) progress="${2:-}"; shift 2 ;;
    -h|--help)
      sed -n '2,9p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "qs-osd: unknown option: $1" >&2; exit 1 ;;
  esac
done

progress_text=""
[[ -n $progress ]] && progress_text="${progress}%"

# JSON-escape the message; other fields are constrained to safe charsets by
# their callers (icon = symbolic name, progress = integer, max = integer).
escape_json() {
  python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.argv[1]))' "$1"
}
msg_json=$(escape_json "$message")

payload=$(printf '{"icon":"%s","message":%s,"value":"%s","progressText":"%s","max":"%s"}' \
    "$icon" "$msg_json" "$progress" "$progress_text" "$max")

# `--` separator forces CLI11 to treat the JSON payload as a positional arg
# rather than trying to match `show` against the `ipc show` subcommand.
quickshell ipc call -- osd show "$payload" >/dev/null 2>&1 || true
