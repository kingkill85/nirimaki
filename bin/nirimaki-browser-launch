#!/bin/bash
# nirimaki:group=browser
# nirimaki:summary=Open the current default browser (resolves via xdg-settings)
# nirimaki:args=[url] [args...]
# nirimaki-browser-launch — open a URL (or start blank) in the system default
# browser. Bound to Mod+Shift+B in keybinds.kdl. Resolves the default
# via xdg-settings so the SettingsMenu's "Default browser" picker
# takes effect on the next press without needing a keybind reload.
#
# Args (all optional): forwarded as positional args to the browser
# binary. Most browsers treat the first non-flag arg as a URL.

set -euo pipefail

desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
[[ -z $desktop ]] && desktop="zen.desktop"

# Resolve the Exec= line from the .desktop — works for whatever name
# the distro happens to ship (Arch: zen.desktop; some forks:
# zen-browser.desktop; etc.). Field codes (%U / %F / %u / …) are
# stripped because we forward our own args.
browser=""
for dir in "$HOME/.local/share/applications" /usr/share/applications /usr/local/share/applications; do
  f="$dir/$desktop"
  if [[ -r $f ]]; then
    browser=$(awk -F= '/^Exec=/{print $2; exit}' "$f" \
              | sed -E 's/%[A-Za-z]//g; s/[[:space:]]+$//')
    break
  fi
done

if [[ -z $browser ]]; then
  echo "nirimaki-browser-launch: $desktop not found in any XDG applications dir" >&2
  exit 1
fi

# The Exec= line may contain arguments + the binary may be an absolute
# path (Zen ships /opt/zen-browser-bin/zen-bin). Split on whitespace.
read -r -a argv <<< "$browser"
if ! command -v "${argv[0]}" >/dev/null 2>&1 && [[ ! -x ${argv[0]} ]]; then
  echo "nirimaki-browser-launch: binary '${argv[0]}' not found (from $desktop)" >&2
  exit 1
fi

exec "${argv[@]}" "$@"
