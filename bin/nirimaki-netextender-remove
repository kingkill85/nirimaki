#!/bin/bash
# nirimaki:group=netextender
# nirimaki:summary=Remove SonicWall NetExtender (package + Nirimaki integration)
# nirimaki:requires-sudo=true

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
. "$HOME/.local/bin/nirimaki-vpn-provider-helpers"

nirimaki_banner "SonicWall NetExtender" "Remove"

if ! command -v netExtender >/dev/null 2>&1; then
  echo "netextender is not installed — nothing to remove."
  nirimaki_pause
  exit 0
fi

echo "Removing:"
echo "  - any registered NetExtender connections (vpns.d/<id>.json)"
echo "  - NEService.service (stopped + disabled)"
echo "  - netextender package"
echo
echo "Leaving in place:"
echo "  - secret-tool keyring entries under schema nirimaki-vpn (per connection)"
echo "    Run e.g. 'secret-tool clear nirimaki-vpn <id>' to drop them."

nirimaki_sudo_prime

echo
echo "Stopping any running tunnel (best-effort)…"
pkill -x netExtender 2>/dev/null || true

echo "Stopping + disabling NEService.service…"
sudo systemctl disable --now NEService.service 2>/dev/null || true

echo "Uninstalling netextender…"
sudo pacman -Rns --noconfirm netextender 2>/dev/null || true

echo
vpn_unregister netextender

echo
echo "  ✓ SonicWall NetExtender removed."

[[ -x $HOME/.local/bin/nirimaki-feature-state ]] && \
  "$HOME/.local/bin/nirimaki-feature-state" >/dev/null 2>&1 || true
[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" netextender-removed || true

nirimaki_pause
