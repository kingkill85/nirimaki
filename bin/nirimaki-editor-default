#!/bin/bash
# nirimaki:group=editor
# nirimaki:summary=Pick the default $EDITOR / $VISUAL from installed editors
#
# Detects installed editors (predefined candidate list filtered by
# `command -v`), shows an fzf picker if 2+ are present, and writes
# `~/.config/fish/conf.d/editor.fish` with `set -gx EDITOR/VISUAL`.
# Bash users get a mirror line in ~/.bashrc.
#
# The candidate list is intentionally short — the Install → Editor
# menu (future batch) will install whichever ones you want, then
# they show up here automatically.

set -e

# shellcheck source=nirimaki-feature-prelude
. "$HOME/.local/bin/nirimaki-feature-prelude"

nirimaki_banner "Default editor" "Select"

# Common candidates, in display order. Special-case: helix's binary
# is `hx` on Arch, `helix` on some distros — accept either.
declare -A LABELS=(
  [nvim]="Neovim (nvim)"
  [helix]="Helix (helix)"
  [hx]="Helix (hx)"
  [code]="VS Code (code)"
  [codium]="VS Codium (codium)"
  [zed]="Zed (zed)"
  [subl]="Sublime Text (subl)"
  [emacs]="Emacs (emacs)"
  [micro]="micro"
  [nano]="GNU nano"
  [vim]="Vim"
)
ORDER=(nvim helix hx code codium zed subl emacs micro nano vim)

installed=()
for bin in "${ORDER[@]}"; do
  command -v "$bin" >/dev/null 2>&1 && installed+=("$bin")
done

if [[ ${#installed[@]} -eq 0 ]]; then
  echo "No editors detected. Install one via Settings → Install → Editor first." >&2
  nirimaki_pause
  exit 1
fi

if [[ ${#installed[@]} -eq 1 ]]; then
  chosen="${installed[0]}"
  echo "Only one editor detected: ${LABELS[$chosen]:-$chosen}"
  echo "Setting it as the default."
else
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not installed — falling back to numbered prompt." >&2
    i=1
    for bin in "${installed[@]}"; do
      printf '  %d) %s\n' "$i" "${LABELS[$bin]:-$bin}"
      i=$((i+1))
    done
    read -r -p "Pick a number: " idx
    [[ $idx =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= ${#installed[@]} )) \
      || { echo "abort"; exit 1; }
    chosen="${installed[$((idx-1))]}"
  else
    # fzf picker: show "<label>\t<bin>"; trim bin off the result.
    chosen=$(
      for bin in "${installed[@]}"; do
        printf '%s\t%s\n' "${LABELS[$bin]:-$bin}" "$bin"
      done | fzf --prompt='default editor> ' \
                 --with-nth=1 --delimiter='\t' --no-multi \
            | cut -f2
    )
    [[ -z $chosen ]] && { echo "abort"; exit 0; }
  fi
fi

# --- write fish env ---
mkdir -p "$HOME/.config/fish/conf.d"
cat >"$HOME/.config/fish/conf.d/editor.fish" <<EOF
# Auto-generated by nirimaki-editor-default — don't hand-edit.
set -gx EDITOR $chosen
set -gx VISUAL $chosen
EOF

# --- mirror to bash ---
# Only patch ~/.bashrc if it exists (it's per-machine, not symlinked).
# We replace any prior nirimaki-managed block to keep this idempotent.
bashrc="$HOME/.bashrc"
if [[ -f $bashrc ]]; then
  python3 - "$bashrc" "$chosen" <<'PY'
import pathlib, sys, re
p = pathlib.Path(sys.argv[1])
chosen = sys.argv[2]
marker_open  = "# >>> nirimaki-editor >>>"
marker_close = "# <<< nirimaki-editor <<<"
block = f"{marker_open}\nexport EDITOR={chosen}\nexport VISUAL={chosen}\n{marker_close}\n"
content = p.read_text()
pat = re.compile(rf"{re.escape(marker_open)}.*?{re.escape(marker_close)}\n?", re.DOTALL)
if pat.search(content):
    content = pat.sub(block, content)
else:
    content = content.rstrip() + "\n\n" + block
p.write_text(content)
PY
fi

echo
echo "  ✓ EDITOR=$chosen   ($(command -v "$chosen"))"
echo "  → new fish / bash shells will pick this up automatically;"
echo "    running shells need to re-source (or just open a new terminal)."

if [[ -x $HOME/.local/bin/nirimaki-hook-run ]]; then
  "$HOME/.local/bin/nirimaki-hook-run" editor-set "$chosen" || true
fi

nirimaki_pause
