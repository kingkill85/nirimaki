#!/bin/bash
# nirimaki:group=editor
# nirimaki:summary=Pick the default $EDITOR / $VISUAL from installed editors
#
# Detects installed editors (predefined candidate list filtered by
# `command -v`), shows an fzf picker if 2+ are present, and writes
# `~/.config/fish/conf.d/editor.fish` with `set -gx EDITOR/VISUAL`.
# Bash users get a mirror line in ~/.bashrc.
#
# The candidate list is intentionally short — the Install → Editor
# menu (future batch) will install whichever ones you want, then
# they show up here automatically.

set -e

# Two modes:
#   nirimaki-editor-default <bin>   ← direct: set <bin> as $EDITOR (used
#                                     by SettingsMenu drilldown leaves)
#   nirimaki-editor-default          ← interactive: fzf-pick among
#                                     installed editors (used by CLI)
#
# When called from the SettingsMenu's drilldown the banner/foot
# shouldn't fire — direct mode is non-interactive and just updates the
# fish + bash env in place. When called interactively from a terminal
# it falls back to the legacy banner + fzf flow.

# --- direct mode (single arg = binary to set) ---
if [[ $# -eq 1 ]]; then
  chosen="$1"
  if ! command -v "$chosen" >/dev/null 2>&1; then
    notify-send -u critical "Editor not installed" \
      "'$chosen' is not on PATH. Install via Settings → Install → Editor first." 2>/dev/null \
      || echo "nirimaki-editor-default: '$chosen' is not on PATH" >&2
    exit 1
  fi
  _interactive=0
else
  # --- interactive mode ---
  # shellcheck source=nirimaki-feature-prelude
  . "$HOME/.local/bin/nirimaki-feature-prelude"
  nirimaki_banner "Default editor" "Select"

  declare -A LABELS=(
    [nvim]="Neovim (nvim)"
    [helix]="Helix (helix)"
    [hx]="Helix (hx)"
    [code]="VS Code (code)"
    [codium]="VS Codium (codium)"
    [zed]="Zed (zed)"
    [subl]="Sublime Text (subl)"
    [emacs]="Emacs (emacs)"
    [micro]="micro"
    [nano]="GNU nano"
    [vim]="Vim"
  )
  ORDER=(nvim helix hx code codium zed subl emacs micro nano vim)

  installed=()
  for bin in "${ORDER[@]}"; do
    command -v "$bin" >/dev/null 2>&1 && installed+=("$bin")
  done

  if [[ ${#installed[@]} -eq 0 ]]; then
    echo "No editors detected. Install one via Settings → Install → Editor first." >&2
    nirimaki_pause
    exit 1
  fi

  if [[ ${#installed[@]} -eq 1 ]]; then
    chosen="${installed[0]}"
    echo "Only one editor detected: ${LABELS[$chosen]:-$chosen}"
    echo "Setting it as the default."
  elif ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not installed — falling back to numbered prompt." >&2
    i=1
    for bin in "${installed[@]}"; do
      printf '  %d) %s\n' "$i" "${LABELS[$bin]:-$bin}"
      i=$((i+1))
    done
    read -r -p "Pick a number: " idx
    [[ $idx =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= ${#installed[@]} )) \
      || { echo "abort"; exit 1; }
    chosen="${installed[$((idx-1))]}"
  else
    chosen=$(
      for bin in "${installed[@]}"; do
        printf '%s\t%s\n' "${LABELS[$bin]:-$bin}" "$bin"
      done | fzf --prompt='default editor> ' \
                 --with-nth=1 --delimiter='\t' --no-multi \
            | cut -f2
    )
    [[ -z $chosen ]] && { echo "abort"; exit 0; }
  fi
  _interactive=1
fi

# --- write the cross-shell single-source-of-truth ---
# Both default/bash/rc and the fish init read this. Bash + fish init
# files in the repo no longer hard-code EDITOR — they read this.
mkdir -p "$HOME/.config/nirimaki"
printf '%s\n' "$chosen" > "$HOME/.config/nirimaki/editor"

# --- mirror to fish conf.d (kept for now; default/bash/rc reads the
#     state file above directly, but fish's own conf.d/editor.fish
#     persists for backward compat with existing fish sessions that
#     don't go through default/bash/rc) ---
mkdir -p "$HOME/.config/fish/conf.d"
cat >"$HOME/.config/fish/conf.d/editor.fish" <<EOF
# Auto-generated by nirimaki-editor-default — don't hand-edit.
set -gx EDITOR $chosen
set -gx VISUAL $chosen
EOF

if [[ ${_interactive:-1} -eq 1 ]]; then
  echo
  echo "  ✓ EDITOR=$chosen   ($(command -v "$chosen"))"
  echo "  → new fish / bash shells will pick this up automatically;"
  echo "    running shells need to re-source (or just open a new terminal)."
else
  # Direct (drilldown) mode — surface success via notify-send since
  # there's no foot window to print to.
  notify-send -u low "Default editor" "$chosen" -t 2500 2>/dev/null || true
fi

if [[ -x $HOME/.local/bin/nirimaki-hook-run ]]; then
  "$HOME/.local/bin/nirimaki-hook-run" editor-set "$chosen" || true
fi

[[ ${_interactive:-1} -eq 1 ]] && nirimaki_pause
