#!/bin/bash
# nirimaki:group=netextender
# nirimaki:summary=Install SonicWall NetExtender SSL-VPN client
# nirimaki:requires-sudo=true

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
. "$HOME/.local/bin/nirimaki-vpn-provider-helpers"

nirimaki_banner "SonicWall NetExtender" "Install"

if command -v netExtender >/dev/null 2>&1; then
  echo "netextender is already installed."
  echo "Re-syncing NEService.service enable state (idempotent)."
else
  echo "Installing:"
  echo "  - netextender (AUR) — SonicWall SSL-VPN CLI client (ppp-based tunnel)"
  echo "  - NEService.service (the netExtender daemon on TCP 51330)"
fi

vpn_locate_repo
nirimaki_sudo_prime

paru -S --needed --noconfirm netextender

echo
echo "Enabling NEService.service (netExtender daemon)…"
# Without this, `netExtender` errors out:
#   "Error: connect to nx service failed: dial tcp :51330: connect: connection refused"
# enable --now is idempotent.
sudo systemctl enable --now NEService.service

echo
echo "  ✓ SonicWall NetExtender installed."
echo "  → Add a connection from Network → VPN → Add connection → SonicWall NetExtender."
echo "    (form collects server / domain / username / password and stores the"
echo "     password in your keyring via secret-tool)"

[[ -x $HOME/.local/bin/nirimaki-feature-state ]] && \
  "$HOME/.local/bin/nirimaki-feature-state" >/dev/null 2>&1 || true
[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" netextender-installed || true

nirimaki_pause
