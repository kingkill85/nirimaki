#!/bin/bash
# nirimaki:group=browser
# nirimaki:summary=Set the system default browser
# nirimaki:args=<chromium|firefox|zen|name.desktop>
# nirimaki-browser-default — set the system default browser.
#
# Thin wrapper around `xdg-settings set default-web-browser` that:
#   - accepts either a short id (chromium / firefox / zen) or a full
#     .desktop filename;
#   - verifies the .desktop exists before calling xdg-settings (else
#     xdg-settings silently sets a broken default);
#   - mirrors the choice into $BROWSER for shells that just started
#     (via ~/.config/fish/conf.d/browser.fish — sourced on next
#     fish launch; can't retrocast to already-running shells).
#
# Used by the Quickshell SettingsMenu "Default browser" entry. Also
# usable directly: `nirimaki browser default firefox`.

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") <chromium|firefox|zen|<name>.desktop>" >&2
  exit 1
fi

# Map alias → candidate .desktop names. Zen specifically ships as
# `zen.desktop` from the AUR/Arch package (binary is `zen-browser`
# at /usr/bin/zen-browser → /opt/zen-browser-bin/zen-bin), so we
# accept either `zen` or `zen-browser` as the alias but always
# resolve to `zen.desktop` on disk. Fallback variant `zen-browser.desktop`
# kept for systems that ship a differently-named desktop entry.
case "$1" in
  chromium)        candidates=("chromium.desktop") ;;
  firefox)         candidates=("firefox.desktop") ;;
  zen|zen-browser) candidates=("zen.desktop" "zen-browser.desktop") ;;
  *.desktop)       candidates=("$1") ;;
  *)               candidates=("$1.desktop") ;;
esac

# Look in the standard XDG dirs. xdg-settings will accept any filename
# even if it doesn't exist, leaving the user with a broken handler —
# verify first.
found=""
desktop=""
for d in "${candidates[@]}"; do
  for dir in "$HOME/.local/share/applications" /usr/share/applications /usr/local/share/applications; do
    if [[ -r "$dir/$d" ]]; then
      found="$dir/$d"
      desktop="$d"
      break 2
    fi
  done
done

if [[ -z $found ]]; then
  echo "nirimaki-browser-default: none of [${candidates[*]}] found in any XDG applications dir" >&2
  exit 1
fi

xdg-settings set default-web-browser "$desktop"

# Also bump $BROWSER for shells started AFTER this point — running
# fish instances aren't affected (universal vars would propagate but
# $BROWSER is treated as exported, not universal).
# Pull the actual binary out of the .desktop's Exec= line so $BROWSER
# is correct regardless of how the .desktop is named (e.g.
# zen.desktop with Exec=/opt/zen-browser-bin/zen-bin).
exec_name=$(awk -F= '/^Exec=/{print $2; exit}' "$found" \
            | sed -E 's/%[A-Za-z]//g; s/[[:space:]]+$//' \
            | awk '{print $1}')
[[ -z $exec_name ]] && exec_name="${desktop%.desktop}"

mkdir -p "$HOME/.config/fish/conf.d"
cat >"$HOME/.config/fish/conf.d/browser.fish" <<EOF
# Auto-generated by nirimaki-browser-default — don't hand-edit.
set -gx BROWSER $exec_name
EOF

echo "default browser → $desktop ($exec_name)"
