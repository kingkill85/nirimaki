#!/bin/bash
# qs-browser-launch — open a URL (or start blank) in the system default
# browser. Bound to Mod+Shift+B in keybinds.kdl. Resolves the default
# via xdg-settings so the SettingsMenu's "Default browser" picker
# takes effect on the next press without needing a keybind reload.
#
# Args (all optional): forwarded as positional args to the browser
# binary. Most browsers treat the first non-flag arg as a URL.

set -euo pipefail

desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
[[ -z $desktop ]] && desktop="zen-browser.desktop"

# Map .desktop → binary name. Hardcoded for the three browsers
# Nirimaki ships; falls back to the desktop's Exec= line for
# anything else.
case "$desktop" in
  zen-browser.desktop) browser="zen-browser" ;;
  firefox.desktop)     browser="firefox" ;;
  chromium.desktop)    browser="chromium" ;;
  *)
    # Resolve Exec= from the .desktop. Strip field codes (%U %F …).
    for dir in "$HOME/.local/share/applications" /usr/share/applications /usr/local/share/applications; do
      f="$dir/$desktop"
      if [[ -r $f ]]; then
        browser=$(awk -F= '/^Exec=/{print $2; exit}' "$f" | sed -E 's/%[A-Za-z]//g; s/[[:space:]]+$//')
        break
      fi
    done
    ;;
esac

if [[ -z ${browser:-} ]] || ! command -v "${browser%% *}" >/dev/null 2>&1; then
  echo "qs-browser-launch: no usable browser (xdg-settings=$desktop)" >&2
  exit 1
fi

exec $browser "$@"
