#!/bin/bash
# nirimaki:summary=Pull the latest Nirimaki + refresh system / AUR packages
# nirimaki:args=[-y]
# nirimaki:requires-sudo=true
#
# nirimaki-update — the canonical "keep my system fresh" entrypoint.
#
# Flow (mirrors omarchy-update at a high level):
#   1. Re-exec self under `script -qefc` so the entire session is
#      captured to /tmp/nirimaki-update.log — invaluable when a
#      pacman/paru run blows up and we need to see what happened.
#   2. Confirmation prompt (skip with `-y`).
#   3. Locate the Nirimaki git checkout via $NIRIMAKI_REPO →
#      ~/.local/share/nirimaki/.git → dev-link fallback.
#   4. Refresh archlinux-keyring (+ cachyos-keyring on CachyOS) first
#      — stale keys are the #1 reason `pacman -Syu` fails silently on
#      long-idle boxes. Auto-recover via `pacman-key --refresh-keys`
#      if the first -Sy is rejected by a DB signature.
#   5. git pull --autostash on the repo.
#   6. paru -Syu (else pacman -Syu) for the system + AUR.
#   7. Refresh feature-state cache + reload niri config.
#   8. Fire ~/.config/nirimaki/hooks/post-update.d/ hooks.
#   9. Detect kernel / niri update → offer to reboot.

set -e
. "$HOME/.local/bin/nirimaki-feature-prelude"

LOG_FILE="/tmp/nirimaki-update.log"

# ---- 1. PTY-wrap for log capture ------------------------------------
# Re-exec inside `script` so progress bars (pacman/paru) keep redrawing
# (they detect a TTY) while the full session is saved for post-mortem.
# Guarded with an env var so the inner shell doesn't loop.
if [[ -z ${NIRIMAKI_UPDATE_LOGGED:-} ]]; then
  cmd=$(printf '%q ' "$0" "$@")
  exec env NIRIMAKI_UPDATE_LOGGED=1 script -qefc "$cmd" "$LOG_FILE"
fi

trap 'rc=$?; echo; printf "\033[0;31mUpdate failed (exit %d).\nThe full log is at %s — review it before retrying.\033[0m\n" "$rc" "$LOG_FILE"; nirimaki_pause' ERR

nirimaki_banner "Nirimaki" "Update"

# ---- 2. Confirmation ------------------------------------------------
yes_flag=0
[[ ${1:-} == "-y" ]] && yes_flag=1

if (( ! yes_flag )); then
  echo "About to update Nirimaki + the system."
  echo "  • Do not interrupt once it starts."
  echo "  • Be on power, or have a healthy battery."
  echo
  read -r -p "Continue? [Y/n] " ans
  case ${ans,,} in
    n|no) echo "Update cancelled."; nirimaki_pause; exit 0 ;;
  esac
  echo
fi

# ---- 3. Locate the Nirimaki git checkout ----------------------------
#   - End-user install: ~/.local/share/nirimaki/ is the clone.
#   - Dev install: ~/.local/share/nirimaki/default → repo/default
#     (symlink set up by dev-link.sh).
#   - Explicit override: $NIRIMAKI_REPO.
repo="${NIRIMAKI_REPO:-}"
if [[ -z $repo ]]; then
  share="$HOME/.local/share/nirimaki"
  if [[ -d $share/.git ]]; then
    repo="$share"
  elif [[ -L $share/default ]]; then
    resolved=$(readlink -f "$share/default")
    repo=$(git -C "$resolved" rev-parse --show-toplevel 2>/dev/null || true)
  fi
fi

if [[ -z $repo || ! -d $repo/.git ]]; then
  echo "Couldn't find the Nirimaki git checkout."
  echo "Set NIRIMAKI_REPO to the repo path and re-run."
  nirimaki_pause
  exit 1
fi

echo "Repo: $repo"
echo

# Prime sudo once so the keyring + pacman/paru steps don't each prompt.
nirimaki_sudo_prime

# ---- 4. keyring refresh ---------------------------------------------
# Always reinstall — keyrings can be updated without a package version
# bump, and missing maintainer keys silently break -Syu. On CachyOS we
# also need `cachyos-keyring` (CachyOS rotates its signing key
# periodically; a stale local keyring rejects the cachyos-extra-v3.db
# signature and the whole -Sy aborts before any package can be
# downloaded). The condition keeps the line working on vanilla Arch
# where the package doesn't exist.
#
# Filters the noisy "is up to date -- reinstalling" warning that
# pacman emits when the install is a no-op. Force LC_ALL=C so the
# filter still matches on non-English locales (German pacman says
# "ist aktuell -- Reinstalliere", etc.).
keyring_pkgs=(archlinux-keyring)
if pacman -Qq cachyos-keyring &>/dev/null; then
  keyring_pkgs+=(cachyos-keyring)
fi

# Recovery branch — if `pacman -Sy` rejects a DB signature (a stale
# trustdb hits this hardest), `pacman-key --refresh-keys` queries the
# configured keyservers for the rotated keys, then we retry once. We
# disable `set -e` around the first attempt so the trap doesn't fire
# on the recoverable failure; the retry runs under normal -e rules so
# a *second* failure still propagates to the ERR trap and the user
# sees the standard "Update failed" message.
echo "=> refresh keyring: ${keyring_pkgs[*]}"
keyring_filter='(archlinux|cachyos)-keyring[^ ]* is up to date -- reinstalling$'
set +e
sudo LC_ALL=C pacman -Sy --noconfirm "${keyring_pkgs[@]}" \
  2> >(grep -vE "$keyring_filter" >&2) >/dev/null
rc=$?
set -e
if (( rc != 0 )); then
  echo "   first attempt failed (likely stale signing keys) — recovering…"
  # Two-stage recovery, cheap → expensive:
  #   1. --populate re-imports keys from the on-disk keyring packages
  #      into pacman's trustdb. Instant; fixes the case where the
  #      trustdb has drifted from the local keyring (idempotent).
  #   2. --refresh-keys hits the WKD / keyserver pool and re-fetches
  #      every key in the trustdb. Slow (1-2 min) but covers the case
  #      where a distro rotated a signing key without bumping the
  #      shipping keyring package.
  populate_targets=(archlinux)
  pacman -Qq cachyos-keyring &>/dev/null && populate_targets+=(cachyos)
  echo "   pacman-key --populate ${populate_targets[*]}"
  sudo pacman-key --populate "${populate_targets[@]}"
  echo "   pacman-key --refresh-keys (this can take a minute)"
  sudo pacman-key --refresh-keys
  echo "   retrying keyring install…"
  sudo LC_ALL=C pacman -Sy --noconfirm "${keyring_pkgs[@]}" \
    2> >(grep -vE "$keyring_filter" >&2) >/dev/null
fi
echo

# ---- 5. git pull ----------------------------------------------------
# Two collision classes get in the way of a clean `git pull` on top of
# a dev-link.sh install:
#
#   A. Dir-symlinks (default/, plugins/builtin/) — dev-link.sh points
#      these back at the user's dev repo. git refuses to write paths
#      "beyond a symbolic link", so any incoming change to those roots
#      aborts the pull. We replace each symlink with HEAD-content
#      (via `git checkout HEAD -- path/`) before the pull and re-link
#      after.
#
#   B. Untracked files — pull aborts when an incoming tracked file
#      would clobber an untracked one in the working tree. Stash
#      everything (tracked changes + untracked files) before the pull,
#      pop after. Pop conflicts get surfaced but don't fail the
#      update — the pull itself already succeeded.
#
# Adding a new dev-linked root? Add its path here. Materializing from
# HEAD (instead of from a stale `.pre-link/`) means the script also
# self-heals when `.pre-link/` is missing, partial, or out of date.

DEV_LINKED_PATHS=(
  "$repo/default"
  "$repo/plugins/builtin"
)
declare -a DEV_LINK_RESTORE_PATHS=()
declare -a DEV_LINK_RESTORE_TARGETS=()

for p in "${DEV_LINKED_PATHS[@]}"; do
  if [[ -L $p ]]; then
    DEV_LINK_RESTORE_PATHS+=("$p")
    DEV_LINK_RESTORE_TARGETS+=("$(readlink "$p")")
    rm "$p"
    # Drop any stale .pre-link/ (and timestamped siblings dev-link.sh
    # leaves behind when it backs up an already-backed-up dir) so the
    # checkout below populates the path with current HEAD content;
    # we'll write a fresh .pre-link/ post-pull from whatever the pull
    # leaves there.
    rm -rf "$p".pre-link "$p".pre-link.* 2>/dev/null || true
    relpath="${p#$repo/}"
    git -C "$repo" checkout HEAD -- "$relpath/" 2>/dev/null || true
  fi
done

if (( ${#DEV_LINK_RESTORE_PATHS[@]} > 0 )); then
  echo "(dev-link: materialised ${#DEV_LINK_RESTORE_PATHS[@]} dir(s) from HEAD for the pull)"
fi

# Stash any local changes + untracked files. `git pull --autostash`
# only handles tracked changes; an untracked file that collides with
# an incoming tracked path would still abort. Manual stash w/ -u
# captures both.
did_stash=0
if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
  if git -C "$repo" stash push --include-untracked --message "nirimaki-update auto" >/dev/null; then
    did_stash=1
    echo "(stashed local changes + untracked files for the pull)"
  fi
fi

_restore_dev_links() {
  local i p t
  for i in "${!DEV_LINK_RESTORE_PATHS[@]}"; do
    p="${DEV_LINK_RESTORE_PATHS[$i]}"
    t="${DEV_LINK_RESTORE_TARGETS[$i]}"
    # Idempotent: if a re-run of this trap already restored, the
    # checks below short-circuit cleanly.
    [[ -d $p && ! -L $p ]] && mv "$p" "$p.pre-link"
    [[ ! -e $p ]] && ln -s "$t" "$p"
  done
}
trap _restore_dev_links EXIT

echo "=> git pull"
git -C "$repo" pull
echo

_restore_dev_links
trap - EXIT
DEV_LINK_RESTORE_PATHS=()
DEV_LINK_RESTORE_TARGETS=()

# Pop the auto-stash. If pop fails (incoming pull overlaps stashed
# content), leave the stash entry alone and tell the user — don't
# fail the update since the pull itself already succeeded.
if (( did_stash )); then
  if ! git -C "$repo" stash pop >/dev/null 2>&1; then
    echo
    echo "  ⚠  Couldn't auto-pop the stash — your local changes are preserved."
    git -C "$repo" stash list | grep "nirimaki-update auto" | head -1 | sed 's/^/     /'
    echo "     Resolve manually:  git -C '$repo' stash pop"
    echo "     Then drop with:    git -C '$repo' stash drop <ref>"
    echo
  fi
fi

# ---- 5b. Run pending migrations -------------------------------------
# System-side one-offs that the repo can't fix via git pull alone
# (re-copy /usr/share files, rebuild initramfs, edit /etc/...). Each
# migration runs at most once per box; state is tracked under
# ~/.local/state/nirimaki/migrations/. See bin/nirimaki-migrate and
# CLAUDE.md → "Migrations".
if [[ -x $HOME/.local/bin/nirimaki-migrate ]]; then
  echo "=> nirimaki-migrate"
  NIRIMAKI_REPO="$repo" "$HOME/.local/bin/nirimaki-migrate"
  echo
fi

# ---- 6. System + AUR refresh ----------------------------------------
if command -v paru >/dev/null 2>&1; then
  echo "=> paru -Syu (system + AUR)"
  paru -Syu --noconfirm
else
  echo "=> pacman -Syu (system only — paru not installed)"
  sudo pacman -Syu --noconfirm
fi
echo

# ---- 7. Feature-state cache + niri config reload --------------------
if [[ -x $HOME/.local/bin/nirimaki-feature-state ]]; then
  "$HOME/.local/bin/nirimaki-feature-state" >/dev/null
fi

if command -v niri >/dev/null 2>&1; then
  niri msg action load-config-file 2>/dev/null || true
fi

# ---- 8. User post-update hooks --------------------------------------
if [[ -x $HOME/.local/bin/nirimaki-hook-run ]]; then
  "$HOME/.local/bin/nirimaki-hook-run" post-update || true
fi

# ---- 9. Reboot-needed detection -------------------------------------
# Kernel: compare running `uname -r` against the directories under
# /usr/lib/modules/. After a kernel update, the dir for the running
# kernel is removed → mismatch → reboot recommended.
needs_reboot=false
reboot_reason=()

running_kernel=$(uname -r)
if [[ -d /usr/lib/modules && ! -d /usr/lib/modules/$running_kernel ]]; then
  needs_reboot=true
  reboot_reason+=("Linux kernel")
fi

# niri (running) was overwritten on disk: /proc/PID/exe gets the
# " (deleted)" suffix once the executable inode is unlinked.
niri_pid=$(pgrep -x niri 2>/dev/null | head -1 || true)
if [[ -n $niri_pid ]]; then
  niri_exe=$(readlink "/proc/$niri_pid/exe" 2>/dev/null || true)
  if [[ $niri_exe == *"(deleted)"* ]]; then
    needs_reboot=true
    reboot_reason+=("niri")
  fi
fi

if $needs_reboot; then
  echo
  printf '%s updated — a reboot is recommended.\n' "$(IFS=' + '; echo "${reboot_reason[*]}")"
  read -r -p "Reboot now? [y/N] " ans
  case ${ans,,} in
    y|yes) systemctl reboot; exit 0 ;;
  esac
fi

echo "Done."
nirimaki_pause
