#!/bin/bash
# nirimaki:group=feature
# nirimaki:summary=Emit ~/.cache/nirimaki/state.json — drives menu's install/remove filter
# nirimaki:hidden=true
#
# Writes a single JSON object mapping feature → boolean (true if
# installed, false otherwise). SettingsMenu.qml FileView-watches the
# file and hides install leaves for already-installed features
# (and remove leaves for not-installed ones).
#
# Run by:
#   - niri spawn-at-startup (initial seed when the session starts)
#   - end of every nirimaki-<feature>-install / -remove (refresh)
#   - manually if you've installed something outside the menu
#     (`nirimaki feature state` to refresh)
#
# Detection strategy per feature:
#   binary on PATH    (fast, works for most CLI/GUI tools)
#   pacman -Qi <pkg>  (handles libs that don't put a binary on PATH)
#   .desktop in XDG   (only for browsers / webapps)
#
# Adding a new feature: append a line below. Keep names lowercase /
# matching the `<feature>` in `bin/nirimaki-<feature>-install`.

set -u

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nirimaki"
OUT="$CACHE_DIR/state.json"
mkdir -p "$CACHE_DIR"

# mise shims (~/.local/share/mise/shims) hold the binaries for every
# language installed via `mise use -g`. Niri spawns this script with a
# minimal PATH (no fish conf.d sourced), so prepend the shim dir so
# `command -v dotnet/ruby/go/…` can find them.
MISE_SHIMS="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"
[[ -d $MISE_SHIMS ]] && PATH="$MISE_SHIMS:$PATH"

has_bin()    { command -v "$1" >/dev/null 2>&1; }
has_pkg()    { pacman -Qi "$1" >/dev/null 2>&1; }
has_helix()  { has_bin hx || has_bin helix; }

emit() { printf '  "%s": %s,\n' "$1" "$2"; }
yn()   { if "$@"; then echo true; else echo false; fi; }

{
  echo '{'
  emit voxtype    "$(yn has_bin voxtype)"
  emit tailscale  "$(yn has_bin tailscale)"
  emit bitwarden  "$(yn has_pkg bitwarden)"
  emit vscode     "$(yn has_bin code)"
  emit helix      "$(yn has_helix)"
  emit steam      "$(yn has_pkg steam)"
  emit zed        "$(yn has_bin zed)"
  emit nvim       "$(yn has_bin nvim)"
  emit docker     "$(yn has_bin docker)"
  # Dev environments — track via the primary binary on PATH. mise-
  # installed tools also land on PATH via mise shims.
  emit dev_ruby    "$(yn has_bin ruby)"
  emit dev_node    "$(yn has_bin node)"
  emit dev_bun     "$(yn has_bin bun)"
  emit dev_deno    "$(yn has_bin deno)"
  emit dev_go      "$(yn has_bin go)"
  emit dev_php     "$(yn has_bin php)"
  emit dev_laravel "$(yn has_bin laravel)"
  emit dev_symfony "$(yn has_bin symfony)"
  emit dev_python  "$(yn has_bin python)"
  emit dev_elixir  "$(yn has_bin elixir)"
  emit dev_phoenix "$(yn has_bin mix)"
  emit dev_rust    "$(yn has_bin rustc)"
  emit dev_java    "$(yn has_bin java)"
  emit dev_zig     "$(yn has_bin zig)"
  emit dev_ocaml   "$(yn has_bin ocaml)"
  emit dev_dotnet  "$(yn has_bin dotnet)"
  emit dev_clojure "$(yn has_bin clojure)"
  emit dev_scala   "$(yn has_bin scala)"
  # Generated. Refreshed on every install/remove + at session start.
  # Last record has no trailing comma (printf below replaces the last
  # `,\n` with `\n`).
  echo '  "_updated": "'"$(date -Iseconds)"'"'
  echo '}'
} > "$OUT.tmp"

# Strip trailing comma on the last data line (we wrote `_updated` as
# the no-comma terminator, so the file is already valid). Move
# atomically so FileView sees a consistent snapshot.
mv "$OUT.tmp" "$OUT"
