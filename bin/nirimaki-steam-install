#!/bin/bash
# nirimaki:group=steam
# nirimaki:summary=Install Steam + matching lib32 GPU drivers (enables multilib if needed)
# nirimaki:requires-sudo=true
#
# GPU detection mirrors Omarchy's `omarchy-install-gaming-gpu-lib32`:
# lspci picks the lib32-vulkan-* driver per detected vendor (AMD /
# Intel / NVIDIA). Audio is left to Pipewire/wireplumber — no
# 32-bit audio packages pulled (matches Omarchy).
#
# Side effect: enables the [multilib] repository in /etc/pacman.conf
# if not active. That's persistent — uninstall doesn't undo it
# (other 32-bit packages may end up depending on it).

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
nirimaki_banner "Steam" "Install"

if pacman -Qi steam >/dev/null 2>&1; then
  echo "steam is already installed."
else
  echo "Installing:"
  echo "  - [multilib] repo (enabled if not already on)"
  echo "  - steam (Valve client)"
  echo "  - 32-bit GPU stack — auto-detected via lspci"
fi

nirimaki_sudo_prime

# Enable multilib repo if not already active.
if ! pacman-conf --repo-list 2>/dev/null | grep -qx multilib; then
  echo
  echo "Enabling [multilib] in /etc/pacman.conf…"
  # Match the standard commented block:
  #   #[multilib]
  #   #Include = /etc/pacman.d/mirrorlist
  # …and uncomment both lines.
  sudo sed -i '/^\s*#\s*\[multilib\]/,/^\s*$/ {
    s/^\s*#\s*\[multilib\]/[multilib]/
    s|^\s*#\s*Include\s*=\s*/etc/pacman.d/mirrorlist|Include = /etc/pacman.d/mirrorlist|
  }' /etc/pacman.conf

  echo "Refreshing pacman databases (multilib now active)…"
  sudo pacman -Sy
fi

echo
echo "Installing Steam…"
sudo pacman -S --needed --noconfirm steam

# 32-bit GPU drivers are factored into a sibling helper so other
# future gaming installs (Lutris, Heroic, …) can reuse it without
# duplicating the lspci detection.
echo
nirimaki-gaming-gpu-lib32

cat <<'NOTE'

  ✓ Steam installed with matching 32-bit GPU stack.
  → Steam is launching now in the background.
  → Proton-GE / MangoHud / gamescope are not installed by default —
    add via pacman/AUR if you need them.
NOTE

# Auto-launch Steam (Omarchy parity: setsid + gtk-launch so it
# survives this script exiting and the foot window closing).
if command -v gtk-launch >/dev/null 2>&1; then
  setsid gtk-launch steam >/dev/null 2>&1 &
fi

[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" steam-installed || true

nirimaki_pause
