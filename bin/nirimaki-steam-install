#!/bin/bash
# nirimaki:group=steam
# nirimaki:summary=Install Steam + matching lib32 GPU drivers (enables multilib if needed)
# nirimaki:requires-sudo=true
#
# GPU detection mirrors Omarchy's `omarchy-install-gaming-gpu-lib32`:
# lspci picks the lib32-vulkan-* driver per detected vendor (AMD /
# Intel / NVIDIA). Audio is left to Pipewire/wireplumber — no
# 32-bit audio packages pulled (matches Omarchy).
#
# Side effect: enables the [multilib] repository in /etc/pacman.conf
# if not active. That's persistent — uninstall doesn't undo it
# (other 32-bit packages may end up depending on it).

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
nirimaki_banner "Steam" "Install"

is_cachyos() {
  [[ -r /etc/os-release ]] && grep -q '^ID=cachyos' /etc/os-release
}

if pacman -Qi steam >/dev/null 2>&1; then
  echo "steam is already installed (refreshing gaming extras)."
else
  echo "Installing:"
  echo "  - [multilib] repo (enabled if not already on)"
  echo "  - steam (Valve client)"
  echo "  - 32-bit GPU stack — auto-detected via lspci"
  echo "  - gamemode + mangohud (and lib32 variants) — universal gaming layer"
  if is_cachyos; then
    echo "  - cachyos-gaming-meta — proton-cachyos-slr, wine-cachyos-opt,"
    echo "    umu-launcher, protontricks, winetricks, vulkan-tools, lib32 audio/GL"
  fi
fi

nirimaki_sudo_prime

# Enable multilib repo if not already active.
if ! pacman-conf --repo-list 2>/dev/null | grep -qx multilib; then
  echo
  echo "Enabling [multilib] in /etc/pacman.conf…"
  # Match the standard commented block:
  #   #[multilib]
  #   #Include = /etc/pacman.d/mirrorlist
  # …and uncomment both lines.
  sudo sed -i '/^\s*#\s*\[multilib\]/,/^\s*$/ {
    s/^\s*#\s*\[multilib\]/[multilib]/
    s|^\s*#\s*Include\s*=\s*/etc/pacman.d/mirrorlist|Include = /etc/pacman.d/mirrorlist|
  }' /etc/pacman.conf

  echo "Refreshing pacman databases (multilib now active)…"
  sudo pacman -Sy
fi

echo
echo "Installing Steam…"
sudo pacman -S --needed --noconfirm steam

# 32-bit GPU drivers are factored into a sibling helper so other
# future gaming installs (Lutris, Heroic, …) can reuse it without
# duplicating the lspci detection.
echo
nirimaki-gaming-gpu-lib32

# Universal gaming layer — gamemode (per-process governor / niceness;
# wrap a game in `gamemoderun %command%`) + mangohud (Vulkan overlay
# for FPS/temps/CPU/GPU; toggle with `MANGOHUD=1 %command%`) +
# ananicy-cpp (auto-nices interactive processes based on rules; tiny
# ~12 MB daemon, system-wide responsiveness boost — keeps games
# snappy when backups / indexers / compiles fight for CPU). lib32
# variants of gamemode/mangohud are pulled because 32-bit Steam
# children need to see them; ananicy-cpp is system-level, no lib32
# counterpart needed.
echo
echo "Installing gaming layer (gamemode + mangohud + ananicy-cpp)…"
sudo pacman -S --needed --noconfirm \
  gamemode lib32-gamemode \
  mangohud lib32-mangohud \
  ananicy-cpp

if ! systemctl is-enabled ananicy-cpp.service >/dev/null 2>&1; then
  echo "Enabling ananicy-cpp.service…"
  sudo systemctl enable --now ananicy-cpp.service
fi

# CachyOS adds proton-cachyos-slr (Steam-runtime variant of their Proton
# fork, exposes PROTON_FSR4_UPGRADE / PROTON_DLSS_UPGRADE / PROTON_XESS_
# UPGRADE / PROTON_DXVK_LOWLATENCY / PROTON_NVIDIA_LIBS), wine-cachyos-opt
# for non-Steam titles, umu-launcher for Lutris/Heroic glue, plus the
# common lib32 audio/GL plumbing many older games need. All bundled
# into cachyos-gaming-meta; only available on the cachyos repo.
if is_cachyos; then
  echo
  echo "Installing cachyos-gaming-meta (Proton-CachyOS + Wine + umu + lib32 audio/GL)…"
  sudo pacman -S --needed --noconfirm cachyos-gaming-meta
fi

cat <<'NOTE'

  ✓ Steam installed with matching 32-bit GPU stack.
  ✓ gamemode + mangohud installed (64 + 32 bit).
NOTE
if is_cachyos; then
  cat <<'NOTE'
  ✓ cachyos-gaming-meta installed — Proton-CachyOS available in
    Steam: Properties → Compatibility → "Proton-CachyOS".
NOTE
fi
cat <<'NOTE'
  → Useful Steam launch options (Properties → General → Launch Options):
      gamemoderun %command%             — per-process governor + niceness
      MANGOHUD=1 %command%              — show FPS/temps overlay
      MANGOHUD=1 gamemoderun %command%  — both, common combo
      PROTON_FSR4_UPGRADE=1 %command%   — vanilla FSR4 (CachyOS-Proton only)
  → Steam is launching now in the background.
NOTE

# Auto-launch Steam (Omarchy parity: setsid + gtk-launch so it
# survives this script exiting and the foot window closing).
if command -v gtk-launch >/dev/null 2>&1; then
  setsid gtk-launch steam >/dev/null 2>&1 &
fi

[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" steam-installed || true

nirimaki_pause
