#!/bin/bash
# nirimaki:group=wireguard
# nirimaki:summary=Remove the Nirimaki WireGuard integration (keeps the package)
# nirimaki:requires-sudo=true

set -e

. "$HOME/.local/bin/nirimaki-feature-prelude"
. "$HOME/.local/bin/nirimaki-vpn-provider-helpers"

nirimaki_banner "WireGuard" "Remove"

if ! command -v wg-quick >/dev/null 2>&1; then
  echo "wireguard-tools is not installed — nothing to remove."
  nirimaki_pause
  exit 0
fi

echo "Removing:"
echo "  - any running wg-quick@*.service tunnels (stopped first)"
echo "  - Nirimaki bar-widget entry (~/.config/nirimaki/vpns.d/wireguard.json)"
echo "  - polkit rule (/etc/polkit-1/rules.d/50-nirimaki-wireguard.rules)"
echo
echo "Leaving in place:"
echo "  - wireguard-tools package (commonly used outside Nirimaki — paru -Rns it yourself if desired)"
echo "  - your /etc/wireguard/*.conf tunnel configs"

nirimaki_sudo_prime

echo
echo "Stopping any active wg-quick tunnels…"
# systemctl list-units --no-legend prints one unit per line. Capture
# active wg-quick@* services, stop each. Empty list → no-op.
mapfile -t wg_units < <(systemctl list-units --type=service --state=active \
                          --no-legend 'wg-quick@*' 2>/dev/null \
                          | awk '{print $1}')
if (( ${#wg_units[@]} == 0 )); then
  echo "  (none active)"
else
  for u in "${wg_units[@]}"; do
    echo "  systemctl stop $u"
    sudo systemctl stop "$u" 2>/dev/null || true
  done
fi

echo
vpn_polkit_remove 50-nirimaki-wireguard.rules

echo
vpn_unregister wireguard

echo
echo "  ✓ WireGuard removed from Nirimaki."

[[ -x $HOME/.local/bin/nirimaki-feature-state ]] && \
  "$HOME/.local/bin/nirimaki-feature-state" >/dev/null 2>&1 || true
[[ -x $HOME/.local/bin/nirimaki-hook-run ]] && \
  "$HOME/.local/bin/nirimaki-hook-run" wireguard-removed || true

nirimaki_pause
